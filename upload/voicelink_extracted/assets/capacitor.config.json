{
	"appId": "ia.z.voicelink",
	"appName": "VoiceLink",
	"webDir": "out",
	"server": {
		"androidScheme": "https"
	},
	"android": {
		"backgroundColor": "#0e0f14",
		"allowMixedContent": true
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 2000,
			"backgroundColor": "#0e0f14",
			"showSpinner": true,
			"spinnerColor": "#4f6ef7",
			"androidScaleType": "CENTER_CROP"
		},
		"StatusBar": {
			"style": "DARK",
			"backgroundColor": "#0e0f14"
		}
	}
}
